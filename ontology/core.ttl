@prefix : <https://infotp.org/ontology/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Basic declarations
#################################################################

:TransitInformationOntology a owl:Ontology ;
    rdfs:label "Transit Information Core Ontology" ;
    rdfs:comment "Core ontology for the design of public transport information systems, structured around architectural catalogs." .

:TransitInformationDomain a owl:Class ;
    rdfs:label "Class Domain" ;
    rdfs:comment "A conceptual domain used to organize architectural knowledge." ;
    rdfs:isDefinedBy :TransitInformationOntology .

#################################################################
# TRANSIT INFORMATION DOMAINS
#################################################################

:ServiceDomain a :TransitInformationDomain ;
    rdfs:isDefinedBy :TransitInformationOntology ;
    rdfs:label "Service Domain" ;
    rdfs:comment "Domain covering service-level concepts related to passenger journeys and experiences." .
:ApplicationDomain a :TransitInformationDomain ;
    rdfs:isDefinedBy :TransitInformationOntology ;
    rdfs:label "Application Domain" ;
    rdfs:comment "Domain focused on software applications and system requirements." .
:DataDomain a :TransitInformationDomain ;
    rdfs:isDefinedBy :TransitInformationOntology ;
    rdfs:label "Data Domain" ;
    rdfs:comment "Domain addressing data entities and processing components within the transit information system." .
:ArchitectureDomain a :TransitInformationDomain ;
    rdfs:isDefinedBy :TransitInformationOntology ;
    rdfs:label "Architecture Domain" ;
    rdfs:comment "Domain related to system architecture, including components and design patterns." .
:TechnologyDomain a :TransitInformationDomain ;
    rdfs:isDefinedBy :TransitInformationOntology ;
    rdfs:label "Technology Domain" ;
    rdfs:comment "Domain concerning technologies, standards, and interfaces used in system implementation." .
:CommunicationDomain a :TransitInformationDomain ;
    rdfs:isDefinedBy :TransitInformationOntology ;
    rdfs:label "Communication Domain" ;
    rdfs:comment "Domain involving communication elements such as branding, signage, and user interfaces." .
:GovernanceDomain a :TransitInformationDomain ;
    rdfs:isDefinedBy :TransitInformationOntology ;
    rdfs:label "Institutional Domain" ;
    rdfs:comment "Domain covering institutional aspects, including actors and organizations involved in governance and operation." .

:belongsToDomain a owl:ObjectProperty ;
    rdfs:label "belongs to domain" ;
    rdfs:domain owl:Class ;
    rdfs:range :TransitInformationDomain ;
    rdfs:comment "Meta-level relation assigning ontology classes to architectural domains." .

#################################################################
# SERVICE (foundational dimensions)
#################################################################

:ServiceSpace a owl:Class ;
    rdfs:label "Space" ;
    rdfs:comment "Physical environment where passengers interact with the transport system." ;
    rdfs:isDefinedBy :TransitInformationOntology .

:ServiceTime a owl:Class ;
    rdfs:label "Time" ;
    rdfs:comment "Temporal moment or phase relevant to passenger journeys." ;
    rdfs:isDefinedBy :TransitInformationOntology .

:ServiceContext a owl:Class ;
    rdfs:label "Context" ;
    rdfs:comment "Situational condition influencing information use and service behavior." ;
    rdfs:isDefinedBy :TransitInformationOntology .

:ServiceStakeholder a owl:Class ;
    rdfs:label "Stakeholder" ;
    rdfs:comment "Individual or group with an interest in or influence over the system." ;
    rdfs:isDefinedBy :TransitInformationOntology .

:ServiceSpace :belongsToDomain :ServiceDomain .
:ServiceTime :belongsToDomain :ServiceDomain .
:ServiceContext :belongsToDomain :ServiceDomain .
:ServiceStakeholder :belongsToDomain :ServiceDomain .

#################################################################
# SERVICE (composed concepts)
#################################################################

:PassengerJourney a owl:Class ;
    rdfs:label "Passenger Journey" ;
    rdfs:comment "A service-level entity representing a passenger's overall journey experience, potentially spanning multiple trips and non-mobility interactions." ;
    rdfs:isDefinedBy :TransitInformationOntology .

:JourneyStage a owl:Class ;
    rdfs:label "Journey Stage" ;
    rdfs:comment "A distinct stage within a passenger journey, characterized by a specific combination of space, time, and context." ;
    rdfs:isDefinedBy :TransitInformationOntology .

:InformationNeed a owl:Class ;
    rdfs:label "Stakeholder Information Need" ;
    rdfs:comment "A general requirement for information needed to support a stakeholder." ;
    rdfs:isDefinedBy :TransitInformationOntology .

:PassengerInformationNeed a owl:Class ;
    rdfs:label "Passenger Information Need" ;
    rdfs:comment "A situated information requirement experienced by a passenger during a specific stage of a journey, under particular spatial, temporal, and contextual conditions." ;
    rdfs:isDefinedBy :TransitInformationOntology ;
    rdfs:subClassOf :InformationNeed .

:PassengerJourney :belongsToDomain :ServiceDomain .
:JourneyStage :belongsToDomain :ServiceDomain .
:PassengerInformationNeed :belongsToDomain :ServiceDomain .

#################################################################
# APPLICATION
#################################################################

:Application a owl:Class ;
    rdfs:label "Application" ;
    rdfs:comment "Software application or service supporting system functions." ;
    rdfs:isDefinedBy :TransitInformationOntology .

:ApplicationRequirement a owl:Class ;
    rdfs:label "Application Requirement" ;
    rdfs:comment "Functional or non-functional constraint on the system." ;
    rdfs:isDefinedBy :TransitInformationOntology .

:Application :belongsToDomain :ApplicationDomain .
:ApplicationRequirement :belongsToDomain :ApplicationDomain .

#################################################################
# DATA
#################################################################

:DataEntity a owl:Class ;
    rdfs:label "Data Entity" ;
    rdfs:comment "Conceptual data object representing a core element of the transport system." ;
    rdfs:isDefinedBy :TransitInformationOntology .

:DataComponent a owl:Class ;
    rdfs:label "Data Component" ;
    rdfs:comment "Logical grouping of data entities used for management or exchange." ;
    rdfs:isDefinedBy :TransitInformationOntology .

:DataEntity :belongsToDomain :DataDomain .
:DataComponent :belongsToDomain :DataDomain .

#################################################################
# ARCHITECTURE
#################################################################

:ArchitectureComponent a owl:Class ;
    rdfs:label "Architecture Component" ;
    rdfs:comment "Logical or technical building block of the system architecture." ;
    rdfs:isDefinedBy :TransitInformationOntology .

:ArchitecturePattern a owl:Class ;
    rdfs:label "Architecture Pattern" ;
    rdfs:comment "Reusable architectural solution to a recurring design problem." ;
    rdfs:isDefinedBy :TransitInformationOntology .

:ArchitectureComponent :belongsToDomain :ArchitectureDomain .
:ArchitecturePattern :belongsToDomain :ArchitectureDomain .

#################################################################
# TECHNOLOGY
#################################################################

:Technology a owl:Class ;
    rdfs:label "Technology" ;
    rdfs:comment "Concrete tool, platform, or software product used in implementation." ;
    rdfs:isDefinedBy :TransitInformationOntology .

:TechnologyStandard a owl:Class ;
    rdfs:label "Standard" ;
    rdfs:comment "Technical specification or norm ensuring interoperability." ;
    rdfs:isDefinedBy :TransitInformationOntology .

:TechnologyInterface a owl:Class ;
    rdfs:label "Interface" ;
    rdfs:comment "Defined interaction point between systems or components." ;
    rdfs:isDefinedBy :TransitInformationOntology .

:Technology :belongsToDomain :TechnologyDomain .
:TechnologyStandard :belongsToDomain :TechnologyDomain .
:TechnologyInterface :belongsToDomain :TechnologyDomain .

#################################################################
# COMMUNICATION
#################################################################

:CommunicationBrand a owl:Class ;
    rdfs:label "Brand" ;
    rdfs:comment "Brand identity associated with the system or its services." ;
    rdfs:isDefinedBy :TransitInformationOntology .

:CommunicationGraphicElement a owl:Class ;
    rdfs:label "Graphic Element" ;
    rdfs:comment "Visual asset used to communicate information consistently." ;
    rdfs:isDefinedBy :TransitInformationOntology .

:CommunicationSignage a owl:Class ;
    rdfs:label "Signage" ;
    rdfs:comment "Physical or digital signage used to orient passengers." ;
    rdfs:isDefinedBy :TransitInformationOntology .

:CommunicationInterface a owl:Class ;
    rdfs:label "User Interface" ;
    rdfs:comment "Visual and interaction layer through which users access services." ;
    rdfs:isDefinedBy :TransitInformationOntology .

:CommunicationBrand :belongsToDomain :CommunicationDomain .
:CommunicationGraphicElement :belongsToDomain :CommunicationDomain .
:CommunicationSignage :belongsToDomain :CommunicationDomain .
:CommunicationInterface :belongsToDomain :CommunicationDomain .

#################################################################
# GOVERNANCE
#################################################################

:GovernanceActor a owl:Class ;
    rdfs:label "Actor" ;
    rdfs:comment "Role that performs actions or interacts with the system." ;
    rdfs:isDefinedBy :TransitInformationOntology .

:GovernanceOrganization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "Institution responsible for governance, operation, or service provision." ;
    rdfs:isDefinedBy :TransitInformationOntology .

:GovernanceInstrument a owl:Class ;
    rdfs:label "Governance Instrument" ;
    rdfs:comment "An abstract artifact through which governance is exercised, including rules, laws, norms, standards, procedures, policies, and other formal or informal mechanisms that guide, constrain, or authorize actions and decision-making within a transit system." ;
    rdfs:isDefinedBy :TransitInformationOntology .

:GovernancePrinciple a owl:Class ;
    rdfs:label "Principle" ;
    rdfs:comment "Architectural or service principle guiding design decisions." ;
    rdfs:isDefinedBy :TransitInformationOntology ;
    rdfs:subClassOf :GovernanceInstrument .

:GovernanceRegulation a owl:Class ;
    rdfs:label "Regulation" ;
    rdfs:comment "Legal or regulatory framework governing transit operations and information systems." ;
    rdfs:isDefinedBy :TransitInformationOntology ;
    rdfs:subClassOf :GovernanceInstrument .

:GovernanceActor :belongsToDomain :GovernanceDomain .
:GovernanceOrganization :belongsToDomain :GovernanceDomain .
:GovernanceInstrument :belongsToDomain :GovernanceDomain .
