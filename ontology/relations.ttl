@prefix : <https://infotp.org/ontology/core#> .
@prefix rel: <https://infotp.org/ontology/relations#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
# Ontology declaration
#################################################################

rel:TransitInformationRelationsOntology a owl:Ontology ;
    rdfs:label "Transit Information Ontology – Relations" ;
    rdfs:comment "Relations describing architectural, service, and informational structures in transit information systems." ;
    owl:imports <https://infotp.org/ontology/core> .

#################################################################
# DOMAIN-LEVEL ARCHITECTURAL RELATIONS
#################################################################
# Intentionally generic (no domain/range)

:implements a owl:ObjectProperty ;
    rdfs:label "implements" ;
    rdfs:comment "Indicates that an element realizes or concretizes another element at a lower level of abstraction." .

:enables a owl:ObjectProperty ;
    rdfs:label "enables" ;
    rdfs:comment "Indicates that an element makes another possible or effective." .

:governedBy a owl:ObjectProperty ;
    rdfs:label "governed by" ;
    rdfs:comment "Indicates that an element is subject to governance or authority." .

:influences a owl:ObjectProperty ;
    rdfs:label "influences" ;
    rdfs:comment "Indicates that an element shapes, motivates, or constrains another." .

:uses a owl:ObjectProperty ;
    rdfs:label "uses" ;
    rdfs:comment "Indicates that one element depends on another for operation or realization." .

#################################################################
# JOURNEY STRUCTURE RELATIONS
#################################################################

:hasStage a owl:ObjectProperty ;
    rdfs:domain :PassengerJourney ;
    rdfs:range :JourneyStage ;
    rdfs:label "has stage" ;
    rdfs:comment "Relates a passenger journey to one of its constituent stages." ;
    owl:inverseOf :stageOf .

:stageOf a owl:ObjectProperty ;
    rdfs:domain :JourneyStage ;
    rdfs:range :PassengerJourney ;
    rdfs:label "stage of" ;
    rdfs:comment "Indicates the journey to which a stage belongs." .

:occursIn a owl:ObjectProperty ;
    rdfs:domain :JourneyStage ;
    rdfs:range :Space ;
    rdfs:label "occurs in" ;
    rdfs:comment "Associates a journey stage with a physical space." .

:occursDuring a owl:ObjectProperty ;
    rdfs:domain :JourneyStage ;
    rdfs:range :Time ;
    rdfs:label "occurs during" ;
    rdfs:comment "Associates a journey stage with a temporal phase." .

:underContext a owl:ObjectProperty ;
    rdfs:domain :JourneyStage ;
    rdfs:range :Context ;
    rdfs:label "under context" ;
    rdfs:comment "Associates a journey stage with situational conditions." .

#################################################################
# INFORMATION NEED RELATIONS
#################################################################

:arisesInStage a owl:ObjectProperty ;
    rdfs:domain :PassengerInformationNeed ;
    rdfs:range :JourneyStage ;
    rdfs:label "arises in stage" ;
    rdfs:comment "Indicates the journey stage in which an information need emerges." .

:hasSpatialScope a owl:ObjectProperty ;
    rdfs:domain :PassengerInformationNeed ;
    rdfs:range :Space ;
    rdfs:label "has spatial scope" .

:hasTemporalScope a owl:ObjectProperty ;
    rdfs:domain :PassengerInformationNeed ;
    rdfs:range :Time ;
    rdfs:label "has temporal scope" .

:isConditionedByContext a owl:ObjectProperty ;
    rdfs:domain :PassengerInformationNeed ;
    rdfs:range :Context ;
    rdfs:label "is conditioned by context" .

#################################################################
# INFORMATION DELIVERY & COMMUNICATION
#################################################################

:isSatisfiedBy a owl:ObjectProperty ;
    rdfs:domain :PassengerInformationNeed ;
    rdfs:label "is satisfied by" ;
    rdfs:comment "Indicates that an information need is fulfilled by some informational element or service." .

:deliveredThrough a owl:ObjectProperty ;
    rdfs:label "delivered through" ;
    rdfs:comment "Indicates the medium through which information is communicated." .

:presentedViaInterface a owl:ObjectProperty ;
    rdfs:range :UserInterface ;
    rdfs:label "presented via interface" ;
    rdfs:comment "Indicates that information is presented through a user interface." .

:displayedOnSignage a owl:ObjectProperty ;
    rdfs:range :Signage ;
    rdfs:label "displayed on signage" ;
    rdfs:comment "Indicates that information is communicated via physical or digital signage." .

#################################################################
# ACTOR INTERACTION
#################################################################

:interactsWith a owl:ObjectProperty ;
    rdfs:domain :Actor ;
    rdfs:label "interacts with" ;
    rdfs:comment "Indicates that an actor engages with a system, interface, or service." .